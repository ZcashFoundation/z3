# Zingod configuration: Testnet (--profile zingod)
#
# - Every key + default: `docker run --rm zingodevops/zingod generate-config -o /dev/stdout`
# - Any key also settable as ZINGOD_CONFIG_<TABLE>__<KEY> (unknown key = refused at boot)

network = "testnet"

[[trusted_validators]]
jsonrpc_address = "zebra:18232"
cookie_path = "/var/run/auth/.cookie"

[serve]
tls = "self_signed"
# Own pair: files in config/<network>/tls/ (readable by uid 1000), reloaded on change
# tls = { cert_path = "/etc/zingod/tls/fullchain.pem", key_path = "/etc/zingod/tls/privkey.pem" }
